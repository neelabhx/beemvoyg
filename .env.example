# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SERPAPI_API_KEY: Optional secret for live Google Flights/Hotels/Local search.
# If absent or invalid, server seamlessly falls back to realistic deterministic dataset.
SERPAPI_API_KEY=""

# USE_MOCK_DATA: Feature flag to force server mock responses ('true' or 'false')
USE_MOCK_DATA="false"

# Supabase Configuration
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_USE_MOCK_DATA="true"

